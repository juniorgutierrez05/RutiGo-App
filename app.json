{
  "expo": {
    "name": "RutiGo",
    "slug": "rutigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "rutigo",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rutigo.app"
    },
    "android": {
      "package": "com.rutigo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFCF8"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "navigationBar": {
        "backgroundColor": "#00000000"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-location",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyAvX0Vs49lCXa4-HAo8HVlEAiG6eZ8ZfDY",
          "iosGoogleMapsApiKey": "AIzaSyBE2j1yA3z2NshDCG_wgDqLKhRtxfnSnW0"
        }
      ],
      "expo-image",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "0834d2ee-652d-497a-9444-b68d09d03518"
      }
    },
    "owner": "juniorgutierrez"
  }
}
