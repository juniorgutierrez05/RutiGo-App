{
  "expo": {
    "name": "RutiGo",
    "slug": "rutigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "rutigo",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFCF8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rutigo.app"
    },
    "android": {
      "package": "com.rutigo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFCF8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
